{
  "name": "@xdev-asia/ui",
  "version": "0.0.0-development",
  "description": "xdev-ui: design tokens and React components for the xDev agent workspace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdev-asia/xdev-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills",
    "bin",
    "assets/brand",
    "README.md",
    "AGENTS.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "xdev-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "xdev-source": "./src/editor/index.ts",
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./image": {
      "xdev-source": "./src/image/index.ts",
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image.js"
    },
    "./styles.css": {
      "xdev-source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "xdev-source": "./src/styles/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./fonts.css": {
      "xdev-source": "./src/styles/fonts.css",
      "default": "./dist/fonts.css"
    },
    "./tokens.json": {
      "xdev-source": "./tokens/tokens.json",
      "default": "./dist/tokens.json"
    },
    "./brand/*": "./assets/brand/*",
    "./ai-manifest.json": "./dist/ai-manifest.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "ai": "node scripts/build-ai.mjs",
    "typecheck": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && vite build && vite build --config vite.mcp.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node scripts/build-tokens.mjs && vite --config vite.demo.config.ts",
    "build:demo": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && vite build --config vite.demo.config.ts && storybook build -o dist-demo/storybook --quiet && node scripts/postbuild.mjs --demo",
    "mcp": "node dist/mcp.js",
    "test": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && vitest run",
    "example:admin": "node scripts/build-tokens.mjs && vite --config examples/admin/vite.config.ts",
    "build:example:admin": "node scripts/build-tokens.mjs && vite build --config examples/admin/vite.config.ts",
    "test:dist": "node scripts/smoke.mjs && node scripts/mcp-smoke.mjs && node scripts/peer-check.mjs",
    "storybook": "node scripts/build-tokens.mjs && storybook dev -p 6006 --no-open"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "react-easy-crop": "^6.2.4"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/markdown": {
      "optional": true
    },
    "react-easy-crop": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "xdev-ui-mcp": "./dist/mcp.js",
    "xdev-ui-skills": "./bin/xdev-ui-skills.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "mcp",
    "mcp-server",
    "llms-txt"
  ]
}
