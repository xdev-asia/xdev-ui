{
  "name": "@xdev-asia/ui",
  "version": "0.0.0-development",
  "description": "xdev-ui: design tokens and React components for the xDev agent workspace.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdev-asia/xdev-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets/brand",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./brand/*": "./assets/brand/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build-tokens.mjs && vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node scripts/build-tokens.mjs && vite --config vite.demo.config.ts",
    "build:demo": "node scripts/build-tokens.mjs && vite build --config vite.demo.config.ts",
    "test": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
