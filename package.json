{
  "name": "@xdev-asia/ui",
  "version": "0.0.0-development",
  "description": "xdev-ui: design tokens and React components for the xDev agent workspace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdev-asia/xdev-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets/brand",
    "README.md",
    "AGENTS.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "xdev-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "xdev-source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "xdev-source": "./src/styles/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./fonts.css": {
      "xdev-source": "./src/styles/fonts.css",
      "default": "./dist/fonts.css"
    },
    "./tokens.json": {
      "xdev-source": "./tokens/tokens.json",
      "default": "./dist/tokens.json"
    },
    "./brand/*": "./assets/brand/*",
    "./ai-manifest.json": "./dist/ai-manifest.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "ai": "node scripts/build-ai.mjs",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && vite build && vite build --config vite.mcp.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node scripts/build-tokens.mjs && vite --config vite.demo.config.ts",
    "build:demo": "node scripts/build-tokens.mjs && node scripts/build-ai.mjs && vite build --config vite.demo.config.ts && node scripts/postbuild.mjs --demo",
    "mcp": "node dist/mcp.js",
    "test": "node scripts/smoke.mjs && node scripts/mcp-smoke.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "xdev-ui-mcp": "./dist/mcp.js"
  },
  "keywords": [
    "design-system",
    "react",
    "mcp",
    "mcp-server",
    "llms-txt"
  ]
}
