{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@xdev-asia/ui": ["./src/index.ts"],
      "@xdev-asia/ui/styles.css": ["./src/styles/index.css"],
      "@xdev-asia/ui/tokens.css": ["./src/styles/tokens.css"],
      "@xdev-asia/ui/fonts.css": ["./src/styles/fonts.css"]
    }
  },
  "include": ["src", "demo", "test", "examples", "skills/*/templates/*/src", "skills/*/templates/*/vite.config.ts", ".storybook", "vite.config.ts", "vitest.config.ts", "vite.demo.config.ts", "vite.mcp.config.ts"],
  "exclude": ["test/fixtures", "node_modules"]
}
